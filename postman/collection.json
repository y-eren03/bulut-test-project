{
  "info": {
    "name": "To-Do List Manager API",
    "description": "Test Collection for To-Do List Manager",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8000/",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8000",
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "Get Tasks",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8000/tasks",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8000",
          "path": [
            "tasks"
          ]
        }
      }
    },
    {
      "name": "Create Task",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "http://localhost:8000/tasks?title=PostmanTask&description=TestFromPostman",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8000",
          "path": [
            "tasks"
          ],
          "query": [
            {
              "key": "title",
              "value": "PostmanTask"
            },
            {
              "key": "description",
              "value": "TestFromPostman"
            }
          ]
        }
      }
    }
    ,{
      "name": "Complete Task",
      "request": {
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "http://localhost:8000/tasks/1/complete",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8000",
          "path": [
            "tasks",
            "1",
            "complete"
          ]
        }
      }
    },
    {
      "name": "Upload Attachment",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": {
          "raw": "http://localhost:8000/tasks/1/attachment",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8000",
          "path": [
            "tasks",
            "1",
            "attachment"
          ]
        }
      }
    }
  ]
}
