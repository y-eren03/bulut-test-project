{
  "info": {
    "name": "To-Do List Manager API",
    "description": "Smoke and API regression collection for the course project.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('health endpoint is up', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Get Tasks",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('tasks list is returned', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks"
      }
    },
    {
      "name": "Create Task",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('task is created', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.title).to.eql('PostmanTask');",
              "  pm.collectionVariables.set('taskId', body.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks?title=PostmanTask&description=TestFromPostman",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"],
          "query": [
            {
              "key": "title",
              "value": "PostmanTask"
            },
            {
              "key": "description",
              "value": "TestFromPostman"
            }
          ]
        }
      }
    },
    {
      "name": "Complete Task",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('task is completed', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().task.is_completed).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [],
        "url": "{{baseUrl}}/tasks/{{taskId}}/complete"
      }
    },
    {
      "name": "Upload Attachment",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('attachment is uploaded', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().task.attachment_url).to.include('todo-attachments');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "postman/sample-attachment.txt"
            }
          ]
        },
        "url": "{{baseUrl}}/tasks/{{taskId}}/attachment"
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    }
  ],
  "collectionVariables": [
    {
      "key": "taskId",
      "value": ""
    }
  ]
}
