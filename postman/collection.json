{
  "info": {
    "name": "To-Do List Manager API",
    "description": "Newman smoke collection for the cloud testing project.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "taskId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('health is ok', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Create Task",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('task created', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.collectionVariables.set('taskId', body.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/tasks?title=PostmanTask&description=PipelineSmoke"
      }
    },
    {
      "name": "Attach Tag",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/tasks/{{taskId}}/tags?name=ci"
      }
    },
    {
      "name": "Get Created Task",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/tasks/{{taskId}}"
      }
    },
    {
      "name": "Task Stats",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/tasks/stats/overview"
      }
    },
    {
      "name": "Complete Task",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/tasks/{{taskId}}/complete"
      }
    },
    {
      "name": "Delete Task",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/tasks/{{taskId}}"
      }
    }
  ]
}
